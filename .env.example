# =============================================================================
# Copy to .env at REPO ROOT (not talkshow-web/). Never commit .env.
#
# LAPTOP (requirements-laptop.txt): need LIVEKIT_* only for tokens + frontend.
# BABEL (requirements.txt, conda talkshow, Python 3.11): Piper paths, VLLM_*, TALKSHOW_* below.
# Replace hsuanhal with your Babel $USER in all /data/user_data/... paths.
# =============================================================================

# LiveKit Cloud — https://cloud.livekit.io/projects/p_.../settings
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# HF cache (shared cluster area; may be purged periodically)
HF_HUB_CACHE=/data/hf_cache/hub
HF_DATASETS_CACHE=/data/hf_cache/datasets

# Turn-detector ONNX (model_q8.onnx) — private agent cache, survives public cache purges
TALKSHOW_TURN_DETECTOR_CACHE=/data/user_data/hsuanhal/livekit-turn-detector/hub

# Babel/Slurm: avoid ONNX pthread_setaffinity_np (turn-detector / Silero)
TALKSHOW_ORT_NUM_THREADS=1

# vLLM on same GPU node as agent worker
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=google/gemma-4-E4B-it
# Local weights: keep VLLM_MODEL as the API id. vllm-gemma4-audio.sh passes
# --served-model-name=${VLLM_MODEL} so chat/completions does not 404.
# VLLM_MODEL_PATH=/data/user_data/hsuanhal/models/gemma-4-E4B-it
# VLLM_SERVED_MODEL_NAME=google/gemma-4-E4B-it
# Agent warms multimodal (audio) path once per session before opening:
# TALKSHOW_GEMMA_MM_WARM=1

# Piper ONNX — private dir (do not use shared /data/hf_cache)
#   bash deploy/download-piper-voices.sh en          # lessac + amy + ryan
#   bash deploy/download-piper-voices.sh zh          # huayan
#   bash deploy/download-piper-voices.sh en zh
#   bash deploy/download-piper-voices.sh --list
#   https://huggingface.co/rhasspy/piper-voices
#   bash deploy/download-piper-voices.sh en_US-kristin-medium zh_CN-xiao_ya-medium
# Replace hsuanhal with your $USER
PIPER_MODEL_PATH=/data/user_data/hsuanhal/piper/en_US-lessac-medium.onnx

# Turn end: default multilingual (bash deploy/download-livekit-agent-models.sh)
# Lower agent RAM (~200MB): TALKSHOW_TURN_DETECTOR=vad  (less accurate end-of-turn)
# Agent worker ~500–700MB with multilingual + Silero is normal; vLLM is separate.
# Emergency VAD-only: TALKSHOW_TURN_DETECTOR=vad
# Ignore VAD blips shorter than this (bytes of wav sent to Gemma)
# TALKSHOW_MIN_UTTERANCE_WAV_BYTES=12000

# Default scenario — host_moderated (hand-raise + host floor control)
# SCENARIO_PATH=config/scenarios/default.yaml
# TALKSHOW_SKIP_GREETING=1
# TALKSHOW_HISTORY_MAX_LINES=48
# TALKSHOW_PANEL_MAX_TURNS=12
# TALKSHOW_HOST_MODERATE_MAX_DEPTH=8
# TALKSHOW_IDLE_TOPIC_SEC=60
# Hand-raise queue: raise anytime; host waits 10s only when queue empty at pick time.
# TALKSHOW_HAND_RAISE_WAIT_SEC=10
# Brief flash of all poll-yes hands before tie-break winner stays up (~0.5s)
# TALKSHOW_HAND_RAISE_FLASH_SEC=0.5
# Pause after poll UI sync, before FIFO pick + grant (let hands show on avatars)
# TALKSHOW_HAND_RAISE_GRANT_PAUSE_SEC=1

# Human mic turn — longer pauses before the agent decides you are done
# TALKSHOW_VAD_MIN_SILENCE_SEC=1.0
# TALKSHOW_MIN_ENDPOINTING_DELAY=0.8
# TALKSHOW_MAX_ENDPOINTING_DELAY=12.0
# When the last human leaves: agent session.shutdown(drain=False) for fast exit
# Set 1 to wait for TTS drain before disconnect
# TALKSHOW_SESSION_DRAIN_ON_LEAVE=0
# Ignore short/quiet VAD blips (panel: Gemma only runs when floor_next=human)
# TALKSHOW_MIN_UTTERANCE_WAV_BYTES=16000
# TALKSHOW_MIN_UTTERANCE_RMS=180

# Piper TTS — ONNX CUDA (needs onnxruntime-gpu). Default GPU = DyStream (1), not vLLM (0).
TALKSHOW_PIPER_CUDA=1
# TALKSHOW_PIPER_CUDA_DEVICE=1   # default: DYSTREAM_CUDA_DEVICE or 1
# Voices prewarm in an idle job process after register (TALKSHOW_IDLE_PROCESSES=1).
# GPU (optional — omit to use script defaults 0 / 1 / 2):
# VLLM_CUDA_DEVICE=0
# DYSTREAM_CUDA_DEVICE=1
# COSYVOICE_CUDA_DEVICE=2   # auto falls back if that GPU is missing
# TALKSHOW_PIPER_CUDA_DEVICE=1
# TALKSHOW_IDLE_PROCESSES=1
# TALKSHOW_PROCESS_INIT_TIMEOUT=180   # Piper×3 CUDA load can exceed default 10s

# Piper TTS — gap between sentences in one line (0 = no extra silence)
# TALKSHOW_PIPER_SENTENCE_SILENCE=0

# -----------------------------------------------------------------------------
# CosyVoice TTS (optional emotion-aware replacement for Piper)
# Upstream: https://github.com/FunAudioLLM/CosyVoice
# Default: CosyVoice-300M-Instruct + mode=instruct (built-in spk_id, NO prompt wav).
# Sidecar on its own conda env. Port 8767. Agent stays on Piper until you flip engine.
# -----------------------------------------------------------------------------
# TALKSHOW_TTS_ENGINE=piper            # piper | cosyvoice
# COSYVOICE_MODE=instruct2
# Fun-CosyVoice3 clone path (do not put comments on the same line as the value)
# COSYVOICE_SIDECAR_URL=http://127.0.0.1:8767
# COSYVOICE_ROOT=/data/user_data/hsuanhal/CosyVoice   # git clone --recursive (has cosyvoice/)
# COSYVOICE_MODEL_DIR=/data/user_data/hsuanhal/CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B
# COSYVOICE_PYTHON=/data/user_data/hsuanhal/miniconda3/envs/cosyvoice_vllm/bin/python
# # or older env name: .../envs/cosyvoice/bin/python
# Install deps (skip broken upstream whisper): bash deploy/install-cosyvoice-env.sh
# Accel env name override: COSYVOICE_CONDA_ENV=cosyvoice_vllm bash deploy/install-cosyvoice-env.sh
# Prefer Fun-CosyVoice3 clone: prompt wavs in repo:
#   bash deploy/bake-cosyvoice-prompts-from-piper.sh          # → cosyvoice-prompts/en_*.wav
#   pip install "piper-tts[zh]"   # once, before --zh
#   bash deploy/bake-cosyvoice-prompts-from-piper.sh --zh
# Paths live in config/personas/*.yaml (tts.cosyvoice.prompt_wav) — not here.
# Optional override only: COSYVOICE_PROMPT_WAV_ZH_HOST=/abs/path.wav
# Latency: COSYVOICE_FP16=1 (default) and COSYVOICE_CACHE_PROMPT=1 (default) on sidecar.
# Speaking rate (CosyVoice tts speed=; 1.0=normal, >1 faster/shorter; default 1.1):
# COSYVOICE_SPEED=1.1
# Warm also pre-registers all cosyvoice-prompts/*.wav + runs a short synth probe:
# COSYVOICE_SIDECAR_WARM_PROMPTS=1
# COSYVOICE_SIDECAR_WARM_PROBE=1
# Optional acceleration (same cosyvoice env via install-cosyvoice-env.sh; see RUN-BABEL.md):
# COSYVOICE_LOAD_VLLM=1
# COSYVOICE_LOAD_TRT=0          # keep 0 if TRT10 EXPLICIT_BATCH error
# COSYVOICE_FP16=0
# CosyVoice × DyStream chunking (agent):
# TALKSHOW_COSYVOICE_CHUNK_MODE=sentence   # default: per-sentence TTS+DyStream (correct cuts)
# # full     = one TTS + one DyStream (largest preroll)
# # tts_once = one TTS + silence-heuristic PCM split (no timestamps; mouth bounds may drift)
# bash deploy/run-cosyvoice-sidecar.sh

# -----------------------------------------------------------------------------
# DyStream avatar (Babel). Setup: deploy/clone-dystream.sh + download-dystream-weights.sh
# Use HF_TOKEN for weights — do not git-clone the HF repo. See avatar/README.md.
# Agent + vLLM on GPU 0; DyStream on 1; CosyVoice on 2 (→1 if only 2 GPUs). Defaults in run-*.sh.
# -----------------------------------------------------------------------------
# DYSTREAM_ROOT=/data/user_data/hsuanhal/dystream
# DYSTREAM_PYTHON=.../envs/dystream/bin/python
# DYSTREAM_CUDA_DEVICE=1

# Enable + transport
# TALKSHOW_AVATAR_ENABLED=1
# TALKSHOW_AVATAR_LK_VIDEO=1             # LiveKit video track (default); 0 = HTTP media server

# Synth mode — default stream = preroll + framewise online; mp4 = legacy bake
# TALKSHOW_AVATAR_SYNTH=stream           # stream | mp4
# TALKSHOW_AVATAR_PREROLL_FRAMES=8       # min floor; dynamic target from gen_fps
# TALKSHOW_AVATAR_PREROLL_PROBE_FRAMES=2 # frames to measure gen_fps (≥2)
# TALKSHOW_AVATAR_PREROLL_MARGIN_FRAMES=4
# TALKSHOW_AVATAR_PREROLL_MARGIN_FACTOR=1.0

# LiveKit publish size / bitrate
# TALKSHOW_AVATAR_VIDEO_WIDTH=512
# TALKSHOW_AVATAR_VIDEO_HEIGHT=512
# TALKSHOW_AVATAR_VIDEO_BITRATE=2500000

# Sentence pipeline (orthogonal to SYNTH): split line + prep next while current plays
# TALKSHOW_AVATAR_CHUNK_STREAM=1         # default on; set 0 for whole-utterance only
# TALKSHOW_AVATAR_CHUNK_MIN_SENTENCE_LEN=20

# Sidecar (recommended) — bash deploy/run-dystream-sidecar.sh
# DYSTREAM_SIDECAR_URL=http://127.0.0.1:8766
# DYSTREAM_SIDECAR_HOST=127.0.0.1
# DYSTREAM_SIDECAR_PORT=8766
# DYSTREAM_SIDECAR_WARM=1                # load models before accepting traffic
# DYSTREAM_SIDECAR_WARM_ROLES=1          # prebuild per-persona portrait caches
# DYSTREAM_SIDECAR_WARM_PROBE=1          # short silence AR probe on warm
# DYSTREAM_SIDECAR_WAIT_SEC=900          # agent wait for sidecar ready on startup

# Paths (defaults under repo)
# AVATAR_ASSETS_DIR=avatar/assets        # portraits + idle loops
# AVATAR_CLIPS_DIR=avatar/runtime/clips  # per-turn wav / frame packs
# HTTP fallback (LK_VIDEO=0): deploy/serve-avatar-media.sh + babel-avatar-urls.sh
# AVATAR_MEDIA_PORT=8765

# Per-role Piper (English) — after: bash deploy/download-piper-voices.sh en
# Host Lessac ← lessac | Guest Amy ← amy | Commentator Ryan ← ryan
PIPER_MODEL_PATH_GUEST=/data/user_data/hsuanhal/piper/en_US-amy-medium.onnx
PIPER_MODEL_PATH_COMMENTATOR=/data/user_data/hsuanhal/piper/en_US-ryan-medium.onnx

# Chinese Piper — after: bash deploy/download-piper-voices.sh zh
# (only used when a zh viewer is present)
# One file for all ZH roles:
# PIPER_MODEL_PATH_ZH=/data/user_data/hsuanhal/piper/zh_CN-huayan-medium.onnx
# Or distinct voices per role (optional):
# PIPER_MODEL_PATH_ZH_HOST=/data/user_data/hsuanhal/piper/zh_CN-chaowen-medium.onnx
# PIPER_MODEL_PATH_ZH_GUEST=/data/user_data/hsuanhal/piper/zh_CN-huayan-medium.onnx
# PIPER_MODEL_PATH_ZH_COMMENTATOR=/data/user_data/hsuanhal/piper/zh_CN-xiao_ya-medium.onnx

# Optional overrides
# CONFIG_PATH=config/multimodal.yaml
# Session JSONL for eval/latency_plot.py and eval/moves_plot.py (default: logs/)
# LOG_DIR=logs
# TALKSHOW_LOG_PROMPTS=1   # full Gemma prompts in agent log (verbose; off by default)

# talkshow-web (reads this same .env via next.config.js — no talkshow-web/.env.local)
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record
# DyStream video avatars — agent panel_roster + LiveKit talkshow-avatar track
NEXT_PUBLIC_DYSTREAM_ENABLED=1
# NEXT_PUBLIC_VRM_ENABLED=0  # unused; VRM panel path removed (letter/DyStream only)
