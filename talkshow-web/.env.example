# talkshow-web reads env from the monorepo root — no .env.local here.
#
#   cp .env.example .env    # at repo root (AI-agent-talkshow/)
#
# Required for Meet API routes (optional if you only use token paste tab):
#   LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET
#
# Connect form default URL uses LIVEKIT_URL automatically (mapped in next.config.js).
# Optional frontend-only overrides in root .env:
#   NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
#   NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record
