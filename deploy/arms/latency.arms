# Latency A/B arms for deploy/ghost-arms.sh. Each arm adds one change to the one
# before it, so each step's gain reads off directly; the most important come first
# in case the job is preempted. Flags are documented in .env.example.
# Every arm pins the FIFO hand-raise queue (TALKSHOW_HOST_DECIDE=fifo), as in the October
# runs: the LLM host is the code default and bypasses most of these fixes.
A TALKSHOW_HOST_DECIDE=fifo
B TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_HOST_DECIDE=fifo
C TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_POLL_DURING_OPEN_FLOOR=1 TALKSHOW_HOST_DECIDE=fifo
D TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_POLL_DURING_OPEN_FLOOR=1 TALKSHOW_DRAFT_AHEAD=1 TALKSHOW_HOST_DECIDE=fifo
# Pacing change under review: no hand-raise flash or grant pause.
E TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_POLL_DURING_OPEN_FLOOR=1 TALKSHOW_DRAFT_AHEAD=1 TALKSHOW_HAND_RAISE_FLASH_SEC=0 TALKSHOW_HAND_RAISE_GRANT_PAUSE_SEC=0 TALKSHOW_HOST_DECIDE=fifo
