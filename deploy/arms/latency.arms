# Latency A/B arms for deploy/ghost-arms.sh. Each arm adds one change to the one
# before it, so each step's gain reads off directly; the most important come first
# in case the job is preempted. Flags are documented in .env.example.
A
B TALKSHOW_PRERENDER_CANNED=1
C TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_POLL_DURING_OPEN_FLOOR=1
D TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_POLL_DURING_OPEN_FLOOR=1 TALKSHOW_DRAFT_AHEAD=1
# Pacing change under review: no hand-raise flash or grant pause.
E TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_POLL_DURING_OPEN_FLOOR=1 TALKSHOW_DRAFT_AHEAD=1 TALKSHOW_HAND_RAISE_FLASH_SEC=0 TALKSHOW_HAND_RAISE_GRANT_PAUSE_SEC=0
