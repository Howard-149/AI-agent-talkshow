# Avatar render steps (TALKSHOW_AVATAR_STEPS) with every latency fix, i.e. arm B of
# latency.arms. Canned host lines play from the cache
# (warmed at the default 5 steps), so the arms differ only in live-rendered lines.
# Pair with `python -m eval.avatar_steps_samples` to judge face quality per step count.
S5 TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_AVATAR_STEPS=5
S4 TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_AVATAR_STEPS=4
S3 TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_AVATAR_STEPS=3
S2 TALKSHOW_PRERENDER_CANNED=1 TALKSHOW_AVATAR_STEPS=2
