# PAD update ablation (eval/pad_ablation.py reads the same sessions): soft-bounded
# update and post-speech arousal decay, each on/off. Interleaved, one run per arm
# per pass (ARMS_RUNS=1) so a preempted job still leaves comparable runs.
FULL_a TALKSHOW_PAD_SOFT_BOUND=1 TALKSHOW_PAD_EXPRESSION_AROUSAL_DECAY=0.12
NOSOFT_a TALKSHOW_PAD_SOFT_BOUND=0 TALKSHOW_PAD_EXPRESSION_AROUSAL_DECAY=0.12
NODECAY_a TALKSHOW_PAD_SOFT_BOUND=1 TALKSHOW_PAD_EXPRESSION_AROUSAL_DECAY=0
NEITHER_a TALKSHOW_PAD_SOFT_BOUND=0 TALKSHOW_PAD_EXPRESSION_AROUSAL_DECAY=0
FULL_b TALKSHOW_PAD_SOFT_BOUND=1 TALKSHOW_PAD_EXPRESSION_AROUSAL_DECAY=0.12
NOSOFT_b TALKSHOW_PAD_SOFT_BOUND=0 TALKSHOW_PAD_EXPRESSION_AROUSAL_DECAY=0.12
NODECAY_b TALKSHOW_PAD_SOFT_BOUND=1 TALKSHOW_PAD_EXPRESSION_AROUSAL_DECAY=0
NEITHER_b TALKSHOW_PAD_SOFT_BOUND=0 TALKSHOW_PAD_EXPRESSION_AROUSAL_DECAY=0
